#!/usr/bin/env bash
set -euo pipefail
VERSION="0.1.0"

# One INDEX.md entry. The dash may be an em dash, an en dash or a hyphen;
# `memory index` always writes the em dash. Passed to awk through ENVIRON
# because `awk -v` would reinterpret the backslashes.
INDEX_ENTRY_RE='^- \[[a-z0-9][a-z0-9-]*\]\([a-z0-9][a-z0-9-]*\.md\) (—|–|-) (gotcha|decision|convention|context|reference): .+$'
export INDEX_ENTRY_RE
INDEX_TEMP_FILES=()

# Small English words dropped from `memory dream`'s similarity tokenizer; they
# carry no topical signal and would otherwise inflate overlap scores.
DREAM_STOPWORDS='the and for with that this from are was not use uses used when into only via per its has have all any but can must should does never always'
export DREAM_STOPWORDS

# `${#var}` counts characters only in a UTF-8 locale. launchd and cron start
# without LANG, so bash would count bytes and a 76-character Cyrillic
# description would look 136 long. Pick a UTF-8 LC_CTYPE when there is none.
use_utf8_ctype() {
  local cur="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" have l nl=$'\n'
  case "$cur" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) return 0 ;; esac
  have="$nl$(locale -a 2>/dev/null || true)$nl"
  for l in C.UTF-8 en_US.UTF-8 C.utf8 en_US.utf8; do
    case "$have" in
      *"$nl$l$nl"*)
        if [ -n "${LC_ALL:-}" ]; then export LC_ALL="$l"; else export LC_CTYPE="$l"; fi
        return 0 ;;
    esac
  done
}
use_utf8_ctype

# Make a relative store location independent of later directory changes.  The
# store itself is canonicalized by init before it is used as a link target.
MEMORY_HOME="${AGENT_MEMORY_HOME:-${HOME:?HOME is not set}/.agent-memory}"
case "$MEMORY_HOME" in
  /*) ;;
  *) MEMORY_HOME="$(pwd -P)/$MEMORY_HOME" ;;
esac

usage() {
  cat <<'EOF'
usage: memory <command> [args]        (memory --version prints the version)

commands:
  init [workspace] [--name <project-name>]  set up .memory/ for this project
  link-group <group>                        link a group's shared memory
  unlink-group <group>                      remove a group link
  index                                     rebuild every INDEX.md from fact frontmatter
  status                                    levels, fact counts, unlinked groups, backup state
  grep <pattern> [grep opts]                search all linked levels (follows the symlinks)
  doctor                                    check symlinks, indexes, frontmatter
  dream --report [--stale-days N] [--workspace <ws>]  read-only whole-store report: duplicates, stale facts
  dream [--workspace <ws>] [--model <m>] [--if-changed] [--full] [--web] [--timeout <min>] [--print-config]
                                            tidy the store with a sandboxed OpenCode run
  backup [--push]                           commit (and push) the store
  install-opencode                          install the global OpenCode plugin
EOF
}

die() { echo "memory: $*" >&2; exit 1; }

canonical_path() {
  local path="$1" dir target
  while [ -L "$path" ]; do
    dir="$(cd -P "$(dirname "$path")" && pwd -P)" || return 1
    target="$(readlink "$path")"
    case "$target" in /*) path="$target" ;; *) path="$dir/$target" ;; esac
  done
  dir="$(cd -P "$(dirname "$path")" && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

valid_slug() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }

require_slug() {
  local kind="$1" value="$2"
  valid_slug "$value" || die "invalid $kind '$value': use lowercase letters, digits, and hyphens"
}

# Canonicalize a direct store entry even if that entry itself is missing.  Its
# parent must exist, which is also required before it can safely be recreated.
canonical_entry() {
  local path="$1" parent
  case "$path" in /*) ;; *) return 1 ;; esac
  # Resolve a present final component as well: a store entry may itself be a
  # symlink, and containment must apply to its real destination, not its text.
  if [ -e "$path" ]; then
    cd -P "$path" 2>/dev/null && pwd -P
    return
  fi
  parent="$(cd -P "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$parent" "$(basename "$path")"
}

is_in_store() {
  case "$1" in "$STORE_HOME"|"$STORE_HOME"/*) return 0 ;; *) return 1 ;; esac
}

# Prints the canonical target only when an absolute symlink points into the
# canonical store.  Callers must not write through a link until this succeeds.
safe_link_target() {
  local link="$1" target resolved
  [ -L "$link" ] || return 1
  target="$(readlink "$link")"
  case "$target" in /*) ;; *) return 1 ;; esac
  resolved="$(canonical_entry "$target")" || return 1
  is_in_store "$resolved" || return 1
  printf '%s\n' "$resolved"
}

ensure_global_gitignore() {
  local f origin source
  f="$(git config --global --path --get core.excludesfile 2>/dev/null || true)"
  if [ -z "$f" ]; then
    f="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
  else
    case "$f" in
      /*) ;;
      *)
        origin="$(git config --global --show-origin --get core.excludesfile 2>/dev/null || true)"
        source="${origin%%$'\t'*}"
        source="${source#file:}"
        [ -n "$source" ] || die "cannot resolve global core.excludesfile"
        f="$(dirname "$source")/$f"
        ;;
    esac
  fi
  f="${f/#\~/$HOME}"
  if [ -f "$f" ] && grep -qxF '.memory/' "$f"; then return 0; fi
  mkdir -p "$(dirname "$f")"
  # Command substitution removes a trailing newline, so an empty result from a
  # nonempty file means its final byte was already a newline.
  if [ -s "$f" ] && [ -n "$(tail -c 1 "$f")" ]; then printf '\n' >> "$f"; fi
  printf '.memory/\n' >> "$f"
  git config --global core.excludesfile "$f"
  echo "added '.memory/' to global gitignore ($f)"
}

# Reject symlinks in new write destinations, including intermediate components.
# This conservative rule avoids following links before creating missing parents.
validate_store_destination() {
  local path="$1" cur="$1"
  is_in_store "$path" || die "unsafe store destination: $path"
  while [ "$cur" != "$STORE_HOME" ]; do
    [ ! -L "$cur" ] || die "unsafe symlink destination: $cur"
    cur="$(dirname "$cur")"
  done
}

cmd_init() {
  local workspace="" name="" name_given=0 proj existing_workspace g target item found
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)
        [ "$name_given" -eq 0 ] || die "--name may be specified only once"
        if [ $# -lt 2 ] || [ -z "$2" ]; then die "--name requires a value"; fi
        name="$2"; name_given=1; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *)
        [ -z "$workspace" ] || die "usage: memory init <workspace> [--name <project-name>]"
        workspace="$1"; shift ;;
    esac
  done
  if [ -z "$workspace" ]; then
    {
      echo "existing workspaces:"
      if [ -d "$MEMORY_HOME" ]; then
        found=0
        for item in "$MEMORY_HOME"/*; do
          [ -e "$item" ] || continue
          basename "$item"
          found=1
        done
        [ "$found" -eq 1 ] || echo "  (none)"
      else
        echo "  (none)"
      fi
      echo "usage: memory init <workspace> [--name <project-name>]"
    } >&2
    exit 1
  fi
  require_slug "workspace name" "$workspace"
  if [ "$name_given" -eq 1 ]; then require_slug "project name" "$name"; fi

  # Establish the store canonical path before accepting any existing link.
  mkdir -p "$MEMORY_HOME"
  STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)"
  MEMORY_HOME="$STORE_HOME"

  for g in .memory/project .memory/workspace; do
    if [ -e "$g" ] || [ -L "$g" ]; then
      [ -L "$g" ] || die "$g exists but is not a symlink"
      safe_link_target "$g" >/dev/null || die "unsafe symlink: $g must target an absolute path inside $STORE_HOME"
    fi
  done

  local ws="$STORE_HOME/$workspace"
  if [ -L .memory/workspace ]; then
    existing_workspace="$(safe_link_target .memory/workspace)" || die "unsafe symlink: .memory/workspace"
    if [ "$existing_workspace" != "$ws/workspace" ]; then
      die ".memory/workspace is bound to $existing_workspace; unlink/rebind it explicitly before initializing '$workspace'"
    fi
  fi

  if [ -L .memory/project ]; then
    target="$(safe_link_target .memory/project)"
    case "$target" in "$ws"/projects/*) ;; *) die ".memory/project is bound outside workspace '$workspace'" ;; esac
  fi
  local here recorded recorded_canon
  here="$(pwd -P)"
  if [ "$name_given" -eq 0 ] && [ -L .memory/project ]; then
    proj="$(safe_link_target .memory/project)" || die "unsafe symlink: .memory/project"
    case "$proj" in
      "$ws"/projects/*) ;;
      *) die ".memory/project is bound to $proj, outside workspace '$workspace'; unlink/rebind it explicitly before initializing '$workspace'" ;;
    esac
  else
    [ -n "$name" ] || name="$(basename "$here")"
    require_slug "project name" "$name"
    proj="$ws/projects/$name"
    validate_store_destination "$proj/.project-path"
    validate_store_destination "$proj/INDEX.md"
    if [ -f "$proj/.project-path" ]; then
      recorded="$(<"$proj/.project-path")"
      # Only a path that exists on this machine and is a different directory
      # is a collision; a foreign or vanished path just gets rebound.
      if [ -n "$recorded" ] && [ -d "$recorded" ]; then
        recorded_canon="$(cd -P "$recorded" && pwd -P)"
        [ "$recorded_canon" = "$here" ] || die "project name '$name' is taken by $recorded; re-run with --name"
      fi
    fi
  fi
  validate_store_destination "$ws/workspace/INDEX.md"
  validate_store_destination "$ws/groups"
  validate_store_destination "$ws/projects"
  validate_store_destination "$proj/INDEX.md"
  validate_store_destination "$proj/.project-path"
  if [ ! -d "$STORE_HOME/.git" ]; then git -C "$STORE_HOME" init -q; fi
  # Temporary index files and dream scratch files must never be backed up.
  local exclude="$STORE_HOME/.git/info/exclude" pat
  if [ -d "$STORE_HOME/.git" ]; then
    mkdir -p "$STORE_HOME/.git/info"
    if [ -f "$exclude" ]; then
      local excludes
      excludes="$(grep -vxF 'memory-dream.*' "$exclude" || true)"
      printf '%s\n' "$excludes" > "$exclude"
    fi
    # shellcheck disable=SC2041 # literal ignore pattern
    for pat in '.memory-index.*'; do
      if [ ! -f "$exclude" ] || ! grep -qxF "$pat" "$exclude"; then
        if [ -s "$exclude" ] && [ -n "$(tail -c 1 "$exclude")" ]; then printf '\n' >> "$exclude"; fi
        printf '%s\n' "$pat" >> "$exclude"
      fi
    done
  fi
  mkdir -p "$ws/workspace" "$ws/groups" "$ws/projects"
  [ -f "$ws/workspace/INDEX.md" ] || : > "$ws/workspace/INDEX.md"

  mkdir -p "$proj"
  [ -f "$proj/INDEX.md" ] || : > "$proj/INDEX.md"
  printf '%s\n' "$here" > "$proj/.project-path"

  mkdir -p .memory/groups
  ln -sfn "$proj" .memory/project
  ln -sfn "$ws/workspace" .memory/workspace

  # Only repair group entries after proving their existing targets are safe.
  for g in .memory/groups/*; do
    [ -L "$g" ] || continue
    target="$(safe_link_target "$g")" || die "unsafe symlink: $g must target an absolute path inside $STORE_HOME"
    [ -e "$target" ] || { mkdir -p "$target"; : > "$target/INDEX.md"; }
  done

  ensure_global_gitignore
  echo "initialized: project memory at $proj"
}

cmd_link_group() {
  [ $# -eq 1 ] || die "usage: memory link-group <group>"
  local group="$1" ws_dir ws gdir existing
  require_slug "group name" "$group"
  [ -L .memory/workspace ] || die "not initialized; run: memory init <workspace>"
  [ -d "$MEMORY_HOME" ] || die "not initialized; run: memory init <workspace>"
  STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)"
  ws_dir="$(safe_link_target .memory/workspace)" || die "unsafe symlink: .memory/workspace must target an absolute path inside $STORE_HOME"
  if [ "$(basename "$ws_dir")" != "workspace" ] || [ "$(dirname "$(dirname "$ws_dir")")" != "$STORE_HOME" ]; then
    die "invalid workspace symlink: .memory/workspace"
  fi
  ws="$(dirname "$ws_dir")"
  gdir="$ws/groups/$group"
  if [ -e ".memory/groups/$group" ] || [ -L ".memory/groups/$group" ]; then
    [ -L ".memory/groups/$group" ] || die ".memory/groups/$group exists but is not a symlink"
    existing="$(safe_link_target ".memory/groups/$group")" || die "unsafe symlink: .memory/groups/$group"
    [ "$existing" = "$gdir" ] || die ".memory/groups/$group is bound to a different group target"
  fi
  validate_store_destination "$gdir/INDEX.md"
  mkdir -p "$gdir"
  [ -f "$gdir/INDEX.md" ] || : > "$gdir/INDEX.md"
  mkdir -p .memory/groups
  ln -sfn "$gdir" ".memory/groups/$group"
  echo "linked group '$group'"
}

cmd_unlink_group() {
  [ $# -eq 1 ] || die "usage: memory unlink-group <group>"
  local group="$1"
  require_slug "group name" "$group"
  [ -L ".memory/groups/$group" ] || die "group '$group' is not linked"
  rm ".memory/groups/$group"
  echo "unlinked group '$group' (its memory stays in the store)"
}

# Value of one flat frontmatter key of a fact file; empty when the key or the
# frontmatter is absent. Only the block between the first two `---` lines is
# read, so a "description:" in the body is never picked up.
frontmatter_value() {
  awk -v k="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    /^---$/ { exit }
    index($0, k ": ") == 1 { print substr($0, length(k) + 3); exit }
  ' "$1"
}

# Gregorian calendar validation for a structurally valid YYYY-MM-DD date.
# Bash arithmetic avoids platform-specific `date` options and 10# prevents
# leading zeroes from being interpreted as octal.
valid_calendar_date() {
  local date="$1" year month day rest y d max
  case "$date" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) return 1 ;;
  esac
  year="${date%%-*}"
  rest="${date#*-}"
  month="${rest%%-*}"
  day="${rest#*-}"
  d=$((10#$day))
  case "$month" in
    01|03|05|07|08|10|12) max=31 ;;
    04|06|09|11) max=30 ;;
    02)
      y=$((10#$year))
      if [ $((y % 4)) -eq 0 ] && { [ $((y % 100)) -ne 0 ] || [ $((y % 400)) -eq 0 ]; }; then
        max=29
      else
        max=28
      fi
      ;;
    *) return 1 ;;
  esac
  [ "$d" -ge 1 ] && [ "$d" -le "$max" ]
}

# Days-from-civil (Howard Hinnant's algorithm): a monotonic day number for a
# YYYY-MM-DD date, computed with pure integer arithmetic so age comparisons
# never depend on a platform-specific `date -d`. Assumes the caller already
# validated the date.
days_from_civil() {
  local date="$1" year month day y m d era yoe mp doy doe
  year="${date%%-*}"
  local rest="${date#*-}"
  month="${rest%%-*}"
  day="${rest#*-}"
  y=$((10#$year)); m=$((10#$month)); d=$((10#$day))
  [ "$m" -le 2 ] && y=$((y - 1))
  if [ "$y" -ge 0 ]; then era=$((y / 400)); else era=$(((y - 399) / 400)); fi
  yoe=$((y - era * 400))
  mp=$(((m + 9) % 12))
  doy=$(((153 * mp + 2) / 5 + d - 1))
  doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
  echo $((era * 146097 + doe - 719468))
}

check_frontmatter() {
  local f="$1" front created updated description_count type_count created_count updated_count status
  IFS= read -r front < "$f" || true
  case "$front" in *$'\r') echo "BAD FRONTMATTER (CRLF line endings): $f"; return ;; esac
  if [ "$front" != "---" ]; then echo "BAD FRONTMATTER (no opening ---): $f"; return; fi
  if awk '
    NR == 1 { next }
    /\r$/ { crlf=1; exit }
    /^---$/ { found=1; exit }
    END {
      if (crlf) exit 2
      if (!found) exit 1
    }
  ' "$f"; then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      echo "BAD FRONTMATTER (CRLF line endings): $f"
    else
      echo "BAD FRONTMATTER (no closing ---): $f"
    fi
    return
  fi
  front="$(awk 'NR == 1 { next } /^---$/ { exit } { print }' "$f")"
  description_count="$(grep -c '^description:' <<< "$front" || true)"
  type_count="$(grep -c '^type:' <<< "$front" || true)"
  created_count="$(grep -c '^created:' <<< "$front" || true)"
  created="$(frontmatter_value "$f" created)"
  [ "$description_count" -eq 1 ] && grep -q '^description: .' <<< "$front" \
    || echo "BAD FRONTMATTER (missing or duplicate description): $f"
  [ "$type_count" -eq 1 ] && grep -Eq '^type: (gotcha|decision|convention|context|reference)$' <<< "$front" \
    || echo "BAD FRONTMATTER (missing or invalid type): $f"
  [ "$created_count" -eq 1 ] && grep -Eq '^created: [0-9]{4}-[0-9]{2}-[0-9]{2}$' <<< "$front" && valid_calendar_date "$created" \
    || echo "BAD FRONTMATTER (missing or invalid created date): $f"
  updated_count="$(grep -c '^updated:' <<< "$front" || true)"
  if [ "$updated_count" -gt 0 ]; then
    updated="$(frontmatter_value "$f" updated)"
    if [ "$updated_count" -ne 1 ] || ! grep -Eq '^updated: [0-9]{4}-[0-9]{2}-[0-9]{2}$' <<< "$front" || ! valid_calendar_date "$updated"; then
      echo "BAD FRONTMATTER (invalid updated date): $f"; return
    fi
    # ISO dates compare correctly as strings.
    if [ -n "$created" ] && [ "$updated" \< "$created" ]; then
      echo "BAD FRONTMATTER (updated $updated is before created $created): $f"
    fi
  fi
}

# Prints a reason and returns nonzero unless a fact can be rendered as a valid
# INDEX.md entry.
fact_is_usable() {
  local f="$1" base problems
  base="$(basename "$f")"
  if ! valid_slug "${base%.md}"; then
    echo "invalid fact slug"
    return 1
  fi
  problems="$(check_frontmatter "$f")"
  if [ -n "$problems" ]; then
    printf '%s\n' "$problems"
    return 1
  fi
  return 0
}

check_index() {
  local index_file="$1"
  awk -v idx="$index_file" '
    /^[[:space:]]*$/ { next }
    {
      if ($0 !~ ENVIRON["INDEX_ENTRY_RE"]) {
        print "MALFORMED INDEX ENTRY: " idx ":" NR ": " $0; next
      }
      label=$0; sub(/^- \[/, "", label); sub(/\].*$/, "", label)
      file=$0; sub(/^- \[[^]]*\]\(/, "", file); sub(/\).*$/, "", file)
      stem=file; sub(/\.md$/, "", stem)
      if (label != stem) { print "MALFORMED INDEX ENTRY: " idx ":" NR ": label does not match " file; next }
      if (seen[file]++) print "DUPLICATE INDEX ENTRY: " idx ": " file
    }
  ' "$index_file"
}

index_files() {
  awk '$0 ~ ENVIRON["INDEX_ENTRY_RE"] { f=$0; sub(/^- \[[^]]*\]\(/, "", f); sub(/\).*$/, "", f); print f }' "$1"
}

# INDEX.md content for one level, rendered from the facts' frontmatter and
# sorted by slug with a fixed collation so every machine produces the same
# bytes. Facts without a usable type/description are skipped with a warning;
# doctor reports them as NOT IN INDEX / BAD FRONTMATTER.
render_index() {
  local level="$1" display="${2:-$1}" f base type desc reason
  {
    for f in "$level"/*.md; do
      [ -e "$f" ] || continue
      printf '%s\n' "$f"
    done
  } | LC_ALL=C sort | while IFS= read -r f; do
    base="$(basename "$f")"
    [ "$base" = "INDEX.md" ] && continue
    [ ! -L "$f" ] || continue   # a symlinked fact could point outside the store
    if ! reason="$(fact_is_usable "$f")"; then
      echo "memory: skipping $display/$base: $reason" >&2
      continue
    fi
    type="$(frontmatter_value "$f" type)"
    desc="$(frontmatter_value "$f" description)"
    printf -- '- [%s](%s) — %s: %s\n' "${base%.md}" "$base" "$type" "$desc"
  done
}

# Lock of a live `memory dream`; removed on exit or signal by cleanup_on_exit.
DREAM_LOCK_FILE=""
# Background `opencode run` of the current dream, killed on timeout or signal.
DREAM_CHILD_PID=""

# shellcheck disable=SC2317,SC2329 # invoked from traps
cleanup_on_exit() {
  local exit_rc=$?
  # Includes failures after a successful agent: reindex, add, commit, SHA read,
  # and update-ref. Never release an unfinished dream as ordinary dirty work.
  if [ "${DREAM_ACTIVE:-0}" -eq 1 ] && [ -n "$DREAM_LOCK_FILE" ]; then
    [ "$exit_rc" -ne 0 ] || exit_rc=1
    printf '%s\n' "$exit_rc" > "$(store_gitdir)/memory-dream.failed"
    echo "memory: dream final persistence failed (exit $exit_rc); FAILED review marker retained. Fix git/index errors and run memory backup; changes must be reviewed." >&2
  fi
  dream_kill_child
  cleanup_index_temps
  if [ -n "$DREAM_LOCK_FILE" ]; then dream_release_lock; fi
}

# shellcheck disable=SC2317,SC2329 # called from cleanup_on_exit
cleanup_index_temps() {
  local temp
  [ "${#INDEX_TEMP_FILES[@]}" -gt 0 ] || return 0
  for temp in "${INDEX_TEMP_FILES[@]}"; do
    rm -f "$temp"
  done
}

# Rebuilds INDEX.md for PUBLISH_LEVELS (labels in PUBLISH_LABELS): every index
# is rendered into a temporary file inside its level first, and only when all
# renders succeeded are they moved into place.
publish_indexes() {
  local i level temp n
  local -a temps=()
  INDEX_TEMP_FILES=()
  trap 'cleanup_on_exit' EXIT
  trap 'dream_signal 143' HUP INT TERM
  i=0
  while [ "$i" -lt "${#PUBLISH_LEVELS[@]}" ]; do
    level="${PUBLISH_LEVELS[$i]}"
    # Leftovers of a killed run; fresh ones may belong to a concurrent `memory index`.
    find "$level" -maxdepth 1 -name '.memory-index.*' -mmin +10 -exec rm -f {} + 2>/dev/null || true
    temp="$(mktemp "$level/.memory-index.XXXXXX")" || die "cannot create temporary index in $level"
    INDEX_TEMP_FILES+=("$temp")
    if ! render_index "$level" "${PUBLISH_LABELS[$i]}" > "$temp"; then
      die "failed to render index for ${PUBLISH_LABELS[$i]}"
    fi
    temps+=("$temp")
    i=$((i + 1))
  done
  i=0
  while [ "$i" -lt "${#PUBLISH_LEVELS[@]}" ]; do
    level="${PUBLISH_LEVELS[$i]}"
    if ! mv "${temps[$i]}" "$level/INDEX.md"; then
      die "failed to publish index for ${PUBLISH_LABELS[$i]}"
    fi
    n="$(grep -c '^- \[' "$level/INDEX.md" || true)"
    echo "indexed ${PUBLISH_LABELS[$i]} ($n facts)"
    i=$((i + 1))
  done
  INDEX_TEMP_FILES=()
  # While a dream lock is held the traps stay; they then only remove the lock.
  [ -n "$DREAM_LOCK_FILE" ] || trap - EXIT HUP INT TERM
}

cmd_index() {
  [ $# -eq 0 ] || die "usage: memory index"
  [ -d .memory ] || die "no .memory/ here (run 'memory init <workspace>' first)"
  [ -d "$MEMORY_HOME" ] || die "no store at $MEMORY_HOME (run 'memory init' first)"
  STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)"
  local link target level i
  local -a levels=() labels=()
  if { [ ! -e .memory/project ] && [ ! -L .memory/project ]; } && \
     { [ ! -e .memory/workspace ] && [ ! -L .memory/workspace ]; }; then
    die "no usable linked levels"
  fi
  for link in .memory/project .memory/workspace; do
    target="$(safe_link_target "$link")" || die "invalid required memory link: $link"
    [ -d "$target" ] || die "broken required memory link: $link"
    levels+=("$target")
    labels+=("$link")
  done
  for link in .memory/groups/*; do
    [ -e "$link" ] || [ -L "$link" ] || continue
    target="$(safe_link_target "$link")" || die "invalid group memory link: $link"
    [ -d "$target" ] || die "broken group memory link: $link"
    levels+=("$target")
    labels+=("$link")
  done
  [ "${#levels[@]}" -gt 0 ] || die "no usable linked levels"
  i=0
  while [ "$i" -lt "${#levels[@]}" ]; do
    level="${levels[$i]}"
    [ ! -d "$level/INDEX.md" ] \
      || die "invalid index destination: ${labels[$i]}/INDEX.md is a directory"
    i=$((i + 1))
  done

  PUBLISH_LEVELS=("${levels[@]}")
  PUBLISH_LABELS=("${labels[@]}")
  publish_indexes
}

doctor_project_hints() {
  local p pp linked
  for p in "$STORE_HOME"/*/projects/*/; do
    [ -d "$p" ] || continue
    p="${p%/}"; pp=""
    [ -f "$p/.project-path" ] && pp="$(<"$p/.project-path")"
    if [ -z "$pp" ] || [ ! -d "$pp" ]; then continue; fi
    linked="$(safe_link_target "$pp/.memory/project" 2>/dev/null || true)"
    [ -n "$linked" ] && [ "$linked" != "$p" ] \
      && echo "PROJECT PATH HINT (possible collision): $p records $pp, which links elsewhere"
  done
  return 0
}

# Classify one .memory/ entry.  Prints one problem line and returns 1, or
# prints nothing and returns 0 when the link is usable.  Order matters:
# a relative target is unsafe by design, a target whose parent does not exist
# is broken (not unsafe), and only a resolvable target outside the store is
# reported as unsafe.
check_link() {
  local link="$1" target resolved
  if [ ! -e "$link" ] && [ ! -L "$link" ]; then echo "MISSING LINK: $link"; return 1; fi
  if [ ! -L "$link" ]; then echo "NOT A SYMLINK: $link"; return 1; fi
  target="$(readlink "$link")"
  case "$target" in
    /*) ;;
    *) echo "UNSAFE SYMLINK: $link -> $target (relative target)"; return 1 ;;
  esac
  if ! resolved="$(canonical_entry "$target")"; then
    echo "BROKEN: $link -> $target (target directory does not exist)"; return 1
  fi
  if ! is_in_store "$resolved"; then
    echo "UNSAFE SYMLINK: $link -> $target (outside $STORE_HOME)"; return 1
  fi
  if [ ! -e "$link" ]; then echo "BROKEN: $link -> $target"; return 1; fi
  return 0
}

# Description text of the INDEX.md entry for one file (after "type: ").
index_description() {
  awk -v want="$2" '$0 ~ ENVIRON["INDEX_ENTRY_RE"] {
    f=$0; sub(/^- \[[^]]*\]\(/, "", f); sub(/\).*$/, "", f)
    if (f == want) { d=$0; sub(/^[^:]*: /, "", d); print d; exit }
  }' "$1"
}

# A [[slug]] resolves if any linked level has slug.md.
wiki_target_exists() {
  local slug="$1" level
  for level in .memory/project .memory/workspace .memory/groups/*; do
    [ -f "$level/$slug.md" ] && return 0
  done
  return 1
}

# Hygiene findings that should not fail doctor: printed under a separate header.
doctor_warnings() {
  [ -d .memory ] || return 0
  [ -d "$STORE_HOME" ] || return 0
  local level f base desc n listed slug
  for level in .memory/project .memory/workspace .memory/groups/*; do
    if [ ! -L "$level" ] || [ ! -d "$level" ] || [ ! -f "$level/INDEX.md" ]; then continue; fi
    for f in "$level"/*.md; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      [ "$base" = "INDEX.md" ] && continue
      desc="$(frontmatter_value "$f" description)"
      n=${#desc}
      [ "$n" -le 120 ] || echo "LONG DESCRIPTION ($n chars > 120): $level/$base"
      listed="$(index_description "$level/INDEX.md" "$base")"
      if [ -n "$desc" ] && [ -n "$listed" ] && [ "$listed" != "$desc" ]; then
        echo "INDEX DESCRIPTION DRIFT: $level/$base (index says '$listed'; run 'memory index')"
      fi
      while IFS= read -r slug; do
        [ -n "$slug" ] || continue
        wiki_target_exists "$slug" || echo "DANGLING WIKI LINK: $level/$base -> [[$slug]]"
      done < <(LC_ALL=C grep -a -o '\[\[[a-z0-9-]*\]\]' "$f" | LC_ALL=C sed 's/^\[\[//; s/\]\]$//' | LC_ALL=C sort -u)
    done
  done
  return 0
}

doctor_problems() {
  [ -d .memory ] || return 0
  if [ ! -d "$STORE_HOME" ]; then
    echo "STORE MISSING: $STORE_HOME (restore it or set AGENT_MEMORY_HOME)"
    return 0
  fi
  local link level f base name listed
  local -a levels=()
  for link in .memory/project .memory/workspace; do
    if check_link "$link"; then levels+=("$link"); fi
  done
  for link in .memory/groups/*; do
    [ -L "$link" ] || continue
    if check_link "$link"; then levels+=("$link"); fi
  done
  # bash < 4.4 aborts on "${levels[@]}" when the array is empty under set -u.
  [ "${#levels[@]}" -gt 0 ] || return 0
  local pt wt
  if pt="$(safe_link_target .memory/project 2>/dev/null)" && wt="$(safe_link_target .memory/workspace 2>/dev/null)"; then
    if [ "$(dirname "$(dirname "$pt")")" != "$(dirname "$wt")" ]; then
      echo "WORKSPACE MISMATCH: .memory/project belongs to workspace '$(basename "$(dirname "$(dirname "$pt")")")' but .memory/workspace to '$(basename "$(dirname "$wt")")'"
    fi
  fi
  for level in "${levels[@]}"; do
    [ -f "$level/INDEX.md" ] || { echo "MISSING INDEX: $level/INDEX.md"; continue; }
    check_index "$level/INDEX.md"
    for f in "$level"/*.md; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      [ "$base" = "INDEX.md" ] && continue
      listed=0
      while IFS= read -r name; do
        if [ "$name" = "$base" ]; then listed=1; break; fi
      done <<< "$(index_files "$level/INDEX.md")"
      [ "$listed" -eq 1 ] || echo "NOT IN INDEX: $level/$base"
      check_frontmatter "$f"
    done
    while IFS= read -r name; do
      [ -f "$level/$name" ] || echo "MISSING FILE: $level/$name (listed in INDEX.md)"
    done < <(index_files "$level/INDEX.md")
  done
  return 0
}

cmd_doctor() {
  [ $# -eq 0 ] || die "usage: memory doctor"
  if [ ! -d .memory ]; then
    echo "no .memory/ in $(pwd -P); nothing to check (run 'memory init <workspace>' to set up memory)"
    return 0
  fi
  local problems hints warnings
  [ -d "$MEMORY_HOME" ] && STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)" || STORE_HOME="$MEMORY_HOME"
  problems="$(doctor_problems)"
  hints="$(doctor_project_hints)"
  warnings="$(doctor_warnings)"
  [ -z "$hints" ] || { echo "project-path hints (not orphan detection):"; printf '%s\n' "$hints"; }
  [ -z "$warnings" ] || { echo "warnings (not failures):"; printf '%s\n' "$warnings"; }
  if [ -n "$problems" ]; then printf '%s\n' "$problems"; die "problems found"; fi
  echo "OK"
}

# ---------------------------------------------------------------------------
# memory dream
#
# `memory dream --report` is a read-only analysis of the whole store;
# `memory dream` hands that report to a sandboxed OpenCode agent that
# consolidates the store (merge duplicates, resolve contradictions, prune
# stale facts) and then rebuilds the indexes and commits.
# ---------------------------------------------------------------------------

# Every level of the store, optionally only one workspace: <ws>/workspace,
# <ws>/groups/<g>, <ws>/projects/<p>. Fills DREAM_LEVELS (canonical paths) and
# DREAM_RELS (store-relative names). Dot entries, invalid names and anything
# whose canonical path leaves the store are skipped.
dream_collect_levels() {
  DREAM_LEVELS=()
  DREAM_RELS=()
  local only="${1:-}" ws wsname d canon
  for ws in "$STORE_HOME"/*/; do
    [ -d "$ws" ] || continue
    ws="${ws%/}"
    wsname="${ws##*/}"
    valid_slug "$wsname" || continue
    [ -z "$only" ] || [ "$only" = "$wsname" ] || continue
    for d in "$ws/workspace" "$ws"/groups/*/ "$ws"/projects/*/; do
      d="${d%/}"
      [ -d "$d" ] || continue
      valid_slug "${d##*/}" || continue
      canon="$(cd -P "$d" 2>/dev/null && pwd -P)" || continue
      is_in_store "$canon" || continue
      DREAM_LEVELS+=("$canon")
      DREAM_RELS+=("${d#"$STORE_HOME"/}")
    done
  done
}

# Similarity, repeated-across-projects and shadowing analysis. Reads sorted
# rows  rel<TAB>ws<TAB>slug<TAB>type<TAB>description<TAB>date<TAB>code  and
# prints tagged lines: "S<TAB>line" (similar), "R<TAB>line" (repeated across
# projects), "H<TAB>line" (same slug in several levels).
#
# Tokens are the slug's words plus the description, lowercased. Anything that
# is not [a-z0-9] or a byte >= 0x80 separates words (so non-ASCII words stay
# whole); words under 3 characters and DREAM_STOPWORDS are dropped and
# duplicates collapse. A pair is reported when it shares >= 2 words and
# |shared| / min(|A|,|B|) >= 0.6. Facts of different workspaces are never
# compared.
dream_pairs() {
  LC_ALL=C awk -F'\t' '
    BEGIN {
      n = split(ENVIRON["DREAM_STOPWORDS"], stopArr, " ")
      for (i = 1; i <= n; i++) STOP[stopArr[i]] = 1
    }
    function tokenize(id, text,   s, arr, nn, i, w, nw, seen) {
      s = tolower(text)
      gsub(/[^a-z0-9\200-\377]+/, " ", s)
      nn = split(s, arr, " ")
      nw = 0
      for (i = 1; i <= nn; i++) {
        w = arr[i]
        if (length(w) < 3) continue
        if (w in STOP) continue
        if (w in seen) continue
        seen[w] = 1
        WORD[id, ++nw] = w
      }
      return nw
    }
    function isproj(i,   parts) {
      split(REL[i], parts, "/")
      return parts[2] == "projects"
    }
    function path(i) {
      return REL[i] "/" SLUG[i] ".md" (CODE[i] != "" ? " [code: " CODE[i] "]" : "")
    }
    {
      N++
      REL[N] = $1; WS[N] = $2; SLUG[N] = $3; CODE[N] = $7
      NW[N] = tokenize(N, $3 " " $5)
      key = $2 SUBSEP $3
      lvl = substr($1, length($2) + 2)
      if (!(key in SC)) { ALLP[key] = 1; SWS[key] = $2; SSLUG[key] = $3; SL[key] = lvl }
      else SL[key] = SL[key] ", " lvl
      SC[key]++
      if (!isproj(N)) ALLP[key] = 0
    }
    END {
      for (a = 1; a <= N; a++) {
        for (b = a + 1; b <= N; b++) {
          if (WS[b] != WS[a]) continue
          shared = 0
          delete SW
          for (x = 1; x <= NW[a]; x++) {
            wa = WORD[a, x]
            for (y = 1; y <= NW[b]; y++) {
              if (wa == WORD[b, y]) { if (!(wa in SW)) { SW[wa] = 1; shared++ }; break }
            }
          }
          minlen = (NW[a] < NW[b]) ? NW[a] : NW[b]
          similar = (shared >= 2 && minlen > 0 && (shared / minlen) >= 0.6)
          repeated = (isproj(a) && isproj(b) && REL[a] != REL[b])
          # Same slug in several projects is reported once per slug below.
          if (repeated && SLUG[a] == SLUG[b]) continue
          if (!similar) continue
          list = ""
          if (similar) {
            ns = 0
            for (k in SW) sw2[++ns] = k
            for (ii = 2; ii <= ns; ii++) {
              tmp = sw2[ii]; jj = ii - 1
              while (jj >= 1 && sw2[jj] > tmp) { sw2[jj + 1] = sw2[jj]; jj-- }
              sw2[jj + 1] = tmp
            }
            list = "shared: " sw2[1]
            for (ii = 2; ii <= ns; ii++) list = list ", " sw2[ii]
            delete sw2
          }
          print (repeated ? "R" : "S") "\t  " path(a) " <-> " path(b) " (" list ")"
        }
      }
      for (key in SC) {
        if (SC[key] < 2) continue
        if (ALLP[key]) print "R\t  " SWS[key] ": " SSLUG[key] " in " SL[key] " (same slug)"
        else print "H\t  " SWS[key] ": " SSLUG[key] " in " SL[key]
      }
    }
  '
}

# Lines of one tag from dream_pairs output, tag stripped.
dream_tag() {
  awk -F'\t' -v t="$1" '$1 == t { print $2 }'
}

# Number of lines in $1 (0 when empty).
dream_count() {
  if [ -z "$1" ]; then echo 0; else printf '%s' "$1" | grep -c '' || true; fi
}

# One report section: header plus the sorted body; nothing when body is empty.
dream_emit() {   # dream_emit <header> <body>
  [ -n "$2" ] || return 0
  echo "$1"
  printf '%s\n' "$2" | LC_ALL=C sort
}

# Store-relative fact path, plus the recorded project directory (if any) so
# the agent can verify the fact against code.
dream_fact_path() {   # dream_fact_path <rel> <file> <code>
  if [ -n "$3" ]; then printf '%s/%s [code: %s]' "$1" "$2" "$3"; else printf '%s/%s' "$1" "$2"; fi
}

# A [[slug]] resolves if any level of the workspace has slug.md.
dream_wiki_exists() {   # dream_wiki_exists <ws> <slug>
  local w="$STORE_HOME/$1" s="$2" f
  for f in "$w/workspace/$s.md" "$w"/groups/*/"$s.md" "$w"/projects/*/"$s.md"; do
    [ -f "$f" ] && return 0
  done
  return 1
}

# Why a project directory in the store is orphaned; empty when it is not.
dream_orphan_reason() {   # dream_orphan_reason <level> <recorded-code-path>
  local level="$1" code="$2" linked
  if [ -z "$code" ]; then echo ".project-path missing"; return; fi
  if [ ! -d "$code" ]; then echo "recorded dir is gone"; return; fi
  linked="$(safe_link_target "$code/.memory/project" 2>/dev/null || true)"
  [ "$linked" = "$level" ] || echo ".memory/project no longer links to this project dir"
}

dream_report() {   # dream_report <stale-days> [<workspace>]
  local stale_days="$1" only="${2:-}" today today_days
  if [ -n "${AGENT_MEMORY_TODAY:-}" ]; then
    valid_calendar_date "$AGENT_MEMORY_TODAY" || die "invalid AGENT_MEMORY_TODAY: $AGENT_MEMORY_TODAY"
    today="$AGENT_MEMORY_TODAY"
  else
    today="$(date +%Y-%m-%d)"
  fi
  today_days="$(days_from_civil "$today")"

  dream_collect_levels "$only"
  local total=${#DREAM_LEVELS[@]} i=0
  local level rel ws code reason line f base slug type desc created updated date age
  local n_entries expected wslug links tab=$'\t' nl=$'\n' fpath
  local rows="" unusable="" stale="" large="" drift="" hygiene=""
  while [ "$i" -lt "$total" ]; do
    level="${DREAM_LEVELS[$i]}"
    rel="${DREAM_RELS[$i]}"
    ws="${rel%%/*}"
    code=""
    i=$((i + 1))

    case "$rel" in
      */projects/*)
        if [ -f "$level/.project-path" ]; then
          IFS= read -r code < "$level/.project-path" || true
          code="${code//$tab/ }"
        fi
        reason="$(dream_orphan_reason "$level" "$code")"
        [ -z "$reason" ] || hygiene="$hygiene  orphan project: $rel ($reason)$nl"
        ;;
    esac

    if [ -f "$level/INDEX.md" ]; then
      n_entries="$(grep -c '^- \[' "$level/INDEX.md" || true)"
      [ "$n_entries" -le 40 ] || large="$large  $rel/INDEX.md ($n_entries entries)$nl"
      expected="$(render_index "$level" "$rel" 2>/dev/null)"
      [ "$expected" = "$(<"$level/INDEX.md")" ] || drift="$drift  $rel/INDEX.md (differs from the facts)$nl"
    else
      drift="$drift  $rel/INDEX.md (missing)$nl"
    fi

    for f in "$level"/*.md; do
      [ -e "$f" ] || [ -L "$f" ] || continue
      base="${f##*/}"
      [ "$base" = "INDEX.md" ] && continue
      slug="${base%.md}"
      fpath="$(dream_fact_path "$rel" "$base" "$code")"
      if [ ! -f "$f" ]; then
        unusable="$unusable  $fpath — not a regular file$nl"
        continue
      fi
      if [ -L "$f" ]; then
        hygiene="$hygiene  symlinked fact ignored: $fpath$nl"
        continue
      fi
      if ! reason="$(fact_is_usable "$f")"; then
        reason="$(printf '%s\n' "$reason" | while IFS= read -r line; do printf '%s; ' "${line%": $f"}"; done)"
        unusable="$unusable  $fpath — ${reason%; }$nl"
        continue
      fi

      type="$(frontmatter_value "$f" type)"
      desc="$(frontmatter_value "$f" description)"
      desc="${desc//$tab/ }"
      created="$(frontmatter_value "$f" created)"
      updated="$(frontmatter_value "$f" updated)"
      date="$created"
      [ -z "$updated" ] || date="$updated"
      rows="$rows$rel$tab$ws$tab$slug$tab$type$tab$desc$tab$date$tab$code$nl"

      age=$((today_days - $(days_from_civil "$date")))
      [ "$age" -le "$stale_days" ] || stale="$stale  $fpath — $type, ${age}d since $date$nl"
      [ "${#desc}" -le 120 ] || hygiene="$hygiene  long description (${#desc} chars): $fpath$nl"
      # A here-string, not `< <(...)`: bash 3.2 leaks a descriptor per process
      # substitution and dies with SIGTRAP after a few hundred facts.
      links="$(LC_ALL=C grep -a -o '\[\[[a-z0-9-]*\]\]' "$f" | LC_ALL=C sed 's/^\[\[//; s/\]\]$//' | LC_ALL=C sort -u || true)"
      while IFS= read -r wslug; do
        [ -n "$wslug" ] || continue
        dream_wiki_exists "$ws" "$wslug" || hygiene="$hygiene  dangling link: $fpath -> [[$wslug]]$nl"
      done <<< "$links"
    done
  done

  local pairs="" similar="" repeated="" shadowed=""
  if [ -n "$rows" ]; then
    pairs="$(printf '%s' "$rows" | LC_ALL=C sort | dream_pairs)"
    similar="$(printf '%s\n' "$pairs" | dream_tag S)"
    repeated="$(printf '%s\n' "$pairs" | dream_tag R)"
    shadowed="$(printf '%s\n' "$pairs" | dream_tag H)"
  fi

  dream_emit "unusable facts (fix frontmatter):" "${unusable%"$nl"}"
  dream_emit "similar facts (merge, or check for contradiction):" "$similar"
  dream_emit "repeated across projects (move shared part to a group or workspace):" "$repeated"
  dream_emit "same slug in several levels (shadowing):" "$shadowed"
  dream_emit "stale facts (older than $stale_days days — verify, update 'updated:', or delete):" "${stale%"$nl"}"
  dream_emit "large indexes (> 40 entries — merge or prune):" "${large%"$nl"}"
  dream_emit "index drift (run 'memory dream' or 'memory index'):" "${drift%"$nl"}"
  dream_emit "hygiene:" "${hygiene%"$nl"}"

  local a b c d e
  a="$(dream_count "$similar")"
  b="$(dream_count "$repeated")"
  c="$(dream_count "$shadowed")"
  d="$(dream_count "${stale%"$nl"}")"
  e="$(dream_count "${unusable%"$nl"}")"
  if [ $((a + b + c + d + e)) -eq 0 ]; then
    echo "dream: memory is tidy — nothing to consolidate"
  else
    echo "dream: $a similar, $b repeated across projects, $c shadowed, $d stale, $e unusable"
  fi
}

# Rebuild INDEX.md of every store level in scope (all, or one workspace).
index_rebuild_levels() {   # index_rebuild_levels [<workspace>]
  local i=0
  dream_collect_levels "${1:-}"
  PUBLISH_LEVELS=()
  PUBLISH_LABELS=()
  while [ "$i" -lt "${#DREAM_LEVELS[@]}" ]; do
    if [ -d "${DREAM_LEVELS[$i]}/INDEX.md" ]; then
      echo "memory: not reindexing ${DREAM_RELS[$i]}: INDEX.md is a directory" >&2
    else
      PUBLISH_LEVELS+=("${DREAM_LEVELS[$i]}")
      PUBLISH_LABELS+=("${DREAM_RELS[$i]}")
    fi
    i=$((i + 1))
  done
  [ "${#PUBLISH_LEVELS[@]}" -gt 0 ] || return 0
  publish_indexes >/dev/null
}

json_path_safe() {
  case "$1" in *'"'*|*"\\"*|*$'\n'*|*'*'*|*'?'*|*'['*|*']'*) return 1 ;; esac
  ! printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'
}

# Code directories recorded by the projects of the store (one absolute path
# per line, sorted, unique), limited to one workspace when given. Missing
# directories and paths JSON/prompt templates cannot hold safely are skipped.
dream_project_dirs() {   # dream_project_dirs [<workspace>]
  local i=0 level code canon out="" nl=$'\n' bs=$'\\' quote='"'
  dream_collect_levels "${1:-}"
  while [ "$i" -lt "${#DREAM_LEVELS[@]}" ]; do
    level="${DREAM_LEVELS[$i]}"
    case "${DREAM_RELS[$i]}" in
      */projects/*)
        code=""
        if [ -f "$level/.project-path" ]; then code="$(cat "$level/.project-path")"; fi
        json_path_safe "$code" || { echo "memory: skipping unsafe project path: $code" >&2; code=""; }
        case "$code" in
          /*) ;;
          *) code="" ;;
        esac
        if [ -n "$code" ] && [ -d "$code" ]; then
          case "$code" in
            *"$quote"*|*"$bs"*|*"$nl"*) ;;
            *)
              canon="$(cd -P "$code" 2>/dev/null && pwd -P)" || canon=""
              json_path_safe "$canon" || { echo "memory: skipping unsafe canonical project path: $canon" >&2; canon=""; }
              case "$canon" in
                ""|*"$quote"*|*"$bs"*) ;;
                *) out="$out$canon$nl" ;;
              esac ;;
          esac
        fi
        ;;
    esac
    i=$((i + 1))
  done
  [ -z "$out" ] || printf '%s' "$out" | LC_ALL=C sort -u
}

# Replace every __NAME__ placeholder of a template. Placeholder values were
# checked for JSON-unsafe characters by the caller. patsub_replacement (bash
# 5.2+) would give '&' in a value a special meaning, so it is turned off.
dream_render() {   # single-pass literal insertion; values are never templates
  printf '%s\n' "$1" | DREAM_STORE="$2" DREAM_BIN="$3" DREAM_HOME="$4" \
    DREAM_DIRS="${DREAM_PROJECT_DIRS:-}" DREAM_WEB="${DREAM_WEB:-0}" LC_ALL=C awk '
    BEGIN { n=split(ENVIRON["DREAM_DIRS"], dirs, "\n") }
    function render(line, dir,   out,i,t,v) {
      out=""
      while (match(line, /__(STORE|MEMORY_BIN|HOME|PROJECT_DIR|WEB_ONLY)__/)) {
        t=substr(line,RSTART,RLENGTH); v=""
        if(t=="__STORE__") v=ENVIRON["DREAM_STORE"]
        if(t=="__HOME__") v=ENVIRON["DREAM_HOME"]
        if(t=="__MEMORY_BIN__") v=ENVIRON["DREAM_BIN"]
        if(t=="__PROJECT_DIR__") v=dir
        out=out substr(line,1,RSTART-1) v; line=substr(line,RSTART+RLENGTH)
      }
      return out line
    }
    {
      if(index($0,"__WEB_ONLY__") && ENVIRON["DREAM_WEB"]!="1") next
      if(index($0,"__PROJECT_DIR__")) {
        for(k=1;k<=n;k++) if(dirs[k]!="") print render($0,dirs[k])
      } else print render($0,"")
    }'
}

# Fact files added or changed since <ref>, including uncommitted and untracked
# ones (deleted facts are left out: there is nothing to read).
dream_changed_facts() {   # dream_changed_facts <ref> [<workspace>]
  local scope="${2:+$2/}"
  {
    git -C "$STORE_HOME" diff --name-only --diff-filter=d "$1" -- ${scope:+"$scope"}
    git -C "$STORE_HOME" ls-files --others --exclude-standard -- ${scope:+"$scope"}
  } | grep -E '\.md$' | grep -v -E '(^|/)INDEX\.md$' | LC_ALL=C sort -u || true
}

# Prompt addendum that limits a run to what changed since the last one. More
# than DREAM_FOCUS_MAX changed facts means a big edit, so the run stays full.
DREAM_FOCUS_MAX=150
dream_focus() {   # dream_focus <last-run-ref> [<workspace>]
  local changed n
  changed="$(dream_changed_facts "$1" "${2:-}")"
  n=0; [ -z "$changed" ] || n="$(printf '%s\n' "$changed" | wc -l | tr -d ' ')"
  [ "$n" -le "$DREAM_FOCUS_MAX" ] || return 0
  printf '%s\n' "Incremental run: the previous run already consolidated the rest of the store."
  if [ "$n" -eq 0 ]; then
    printf '%s\n' "No fact changed since then. Handle only the report's hygiene items, skip the rest of step 2 and all of step 3, and finish."
    return 0
  fi
  printf '%s\n' "Only these $n facts were added or changed since then:"
  printf '%s\n' "$changed" | sed 's/^/- /'
  printf '%s\n' "In step 2, handle hygiene items, and other items only when they involve one of these facts. In step 3, read only the INDEX.md files of the levels holding these facts, plus their groups and workspace, and compare these facts with the rest; do not re-check facts that are not listed."
}

# Absolute git directory of the store (lock and scratch files live there).
store_gitdir() { git -C "$STORE_HOME" rev-parse --absolute-git-dir 2>/dev/null; }

# git on the store as a service repo: never prompts, signs, opens an editor or
# runs the user's hooks.
store_git() {
  env GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true \
    git -C "$STORE_HOME" -c commit.gpgsign=false -c core.hooksPath=/dev/null "$@"
}

# Run a command, retrying while another git process holds .git/index.lock.
store_retry() {
  local i=1 rc gd
  gd="$(store_gitdir)" || gd="$STORE_HOME/.git"
  while :; do
    "$@" && return 0
    rc=$?
    { [ "$i" -lt 5 ] && [ -e "$gd/index.lock" ]; } || return "$rc"
    i=$((i + 1))
    sleep 1
  done
}

# Job control gives the run its own process group on Bash 3.2, without setsid.
# Signal the entire group, including grandchildren after their parent exits.
DREAM_WATCHDOG_PID=""
DREAM_CHILD_GROUP=""
DREAM_KILL_GRACE="${AGENT_MEMORY_DREAM_KILL_GRACE:-5}"
DREAM_ACTIVE=0
DREAM_STDERR_SAVED=0
# Store-relative level directories that existed before the agent ran.
DREAM_LEVELS_BEFORE=""
DREAM_FAIL_DETAIL=""
DREAM_WORKSPACE=""

dream_kill_tree() {
  kill -s "$2" -- "-$1" 2>/dev/null || true
}

dream_stop_watchdog() {
  [ -n "$DREAM_WATCHDOG_PID" ] || return 0
  dream_kill_tree "$DREAM_WATCHDOG_PID" KILL
  { wait "$DREAM_WATCHDOG_PID" || true; } 2>/dev/null
  DREAM_WATCHDOG_PID=""
}

# shellcheck disable=SC2317,SC2329 # called from traps
dream_kill_child() {
  dream_stop_watchdog
  [ -n "$DREAM_CHILD_GROUP" ] || return 0
  dream_kill_tree "$DREAM_CHILD_GROUP" TERM
  sleep "$DREAM_KILL_GRACE"
  dream_kill_tree "$DREAM_CHILD_GROUP" KILL
  { wait "$DREAM_CHILD_PID" || true; } 2>/dev/null
  DREAM_CHILD_PID=""
  DREAM_CHILD_GROUP=""
}

# Atomic directory creation is the common writer protocol for ALL backups and
# dreams. Incomplete metadata is not evidence of staleness. We deliberately do
# not auto-remove stale locks: unlink/takeover cannot safely compare directory
# identity atomically in portable shell. Recovery requires an operator to
# verify the recorded pid/start and remove the directory while writers are idle.
writer_lock_recovery_help() {
  local lock
  lock="$(store_gitdir)/memory-dream.lock"
  echo "Writer lock: $lock (pid $(dream_lock_holder)). Stop ALL memory writers before manual recovery."
  if [ -d "$lock" ]; then
    echo "Inspect owner metadata $lock/owner; verify BOTH PID and process start time with ps -o lstart= -p <PID>. Unpublished/missing metadata is uncertain, not stale. Only after verifying no writer is active, remove owner then rmdir the lock directory."
  else
    echo "Legacy lock FILE (not directory): inspect $lock and verify PID/start identity; only after verifying no writer is active remove this file."
  fi
}

dream_lock_acquire() {
  local lock start
  [ -z "$DREAM_LOCK_FILE" ] || return 0
  lock="$(store_gitdir)/memory-dream.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    return 1
  fi
  DREAM_LOCK_FILE="$lock"
  trap 'cleanup_on_exit' EXIT
  trap 'dream_signal 143' HUP INT TERM
  start="$(ps -o lstart= -p "$$" 2>/dev/null | sed 's/^ *//; s/ *$//' || true)"
  printf '%s\n%s\n' "$$" "$start" > "$lock/owner"
}

dream_release_lock() {
  if [ -n "$DREAM_LOCK_FILE" ]; then
    rm -f "$DREAM_LOCK_FILE/owner"
    rmdir "$DREAM_LOCK_FILE" || die "cannot release writer lock $DREAM_LOCK_FILE"
  fi
  DREAM_LOCK_FILE=""
  trap - EXIT HUP INT TERM
}

# A persistent failure marker is published BEFORE attempting a commit, so an
# identity/index failure cannot make the next backup silently absorb the run.
# 0 = committed, 2 = no changes, 3 = staging/commit failure (marker retained).
dream_commit_failed() {   # dream_commit_failed <rc> [<detail>]
  local marker detail="${2:-}"
  local -a msgargs
  marker="$(store_gitdir)/memory-dream.failed"
  { printf '%s\n' "$1"; [ -z "$detail" ] || printf '%s\n' "$detail"; } > "$marker" || return 3
  msgargs=(-m "memory: dream FAILED (exit $1) — review")
  [ -z "$detail" ] || msgargs+=(-m "$detail")
  store_retry store_git add -A || return 3
  if store_git diff --cached --quiet; then rm -f "$marker"; return 2; fi
  store_retry store_git commit -q "${msgargs[@]}" || return 3
  rm -f "$marker"
}

# Paths the agent left behind that the sandbox matcher cannot forbid: a fact
# under a level directory that did not exist before the run, a nested file, a
# hidden or non-Markdown file, a rename or a deletion. Prints one path per line;
# nothing is deleted. Must run before the failure path reindexes the store.
dream_unexpected_paths() {
  local line code path level ok out="" nl=$'\n'
  local re_lvl='^([a-z0-9][a-z0-9-]*)/(projects|groups)/([a-z0-9][a-z0-9-]*)/[^/.][^/]*\.md$'
  local re_ws='^([a-z0-9][a-z0-9-]*)/workspace/[^/.][^/]*\.md$'
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    code="${line:0:2}"
    path="${line:3}"
    ok=0
    case "$code" in
      '??'|' M'|'M '|'A '|'AM'|'MM')
        level=""
        if [[ "$path" =~ $re_lvl ]]; then
          level="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
        elif [[ "$path" =~ $re_ws ]]; then
          level="${BASH_REMATCH[1]}/workspace"
        fi
        if [ -n "$level" ]; then
          case "$nl$DREAM_LEVELS_BEFORE$nl" in *"$nl$level$nl"*) ok=1 ;; esac
        fi ;;
    esac
    [ "$ok" -eq 1 ] || out="$out$path$nl"
  # status.renames=false: a staged delete plus add must stay two plain entries
  # ("D  old", "A  new"), never "R  old -> new", whatever the content similarity.
  done <<< "$(store_git -c status.renames=false status --porcelain=v1 --untracked-files=all 2>/dev/null || true)"
  printf '%s' "${out%"$nl"}"
}

dream_failure_finalize() {
  local rc="$1" why="$2" status=0 unexpected
  DREAM_ACTIVE=0
  DREAM_FAIL_DETAIL=""
  unexpected="$(dream_unexpected_paths | head -n 50)"
  if [ -n "$unexpected" ]; then
    DREAM_FAIL_DETAIL="unexpected paths left by the agent (nothing was deleted; review them):
$(printf '%s\n' "$unexpected" | sed 's/^/- /')"
    echo "memory: unexpected paths left by the agent (not deleted):" >&2
    printf '%s\n' "$unexpected" | sed 's/^/  /' >&2
  fi
  printf '%s\n' "$rc" > "$(store_gitdir)/memory-dream.failed"
  index_rebuild_levels "$DREAM_WORKSPACE" || true
  dream_commit_failed "$rc" "$DREAM_FAIL_DETAIL" || status=$?
  case "$status" in
    0) echo "memory: $why; changes committed as FAILED review; undo with: git -C '$STORE_HOME' revert HEAD" >&2 ;;
    2) echo "memory: $why; the store has no changes to review" >&2 ;;
    *) echo "memory: $why; FAILED review commit could not be created; changes remain uncommitted. Failure marker retained; fix git and run memory backup (then git -C '$STORE_HOME' revert HEAD)." >&2 ;;
  esac
}

# Disable repeated signal traps during termination/finalization; the writer
# lock remains held until children are killed and the failure is recorded.
# shellcheck disable=SC2317,SC2329 # invoked from traps
dream_signal() {
  trap '' HUP INT TERM
  # The trap can fire inside `{ wait ...; } 2>/dev/null`, which would swallow
  # every notice below; restore the caller's stderr saved before the launch.
  if [ "$DREAM_STDERR_SAVED" -eq 1 ]; then exec 2>&3; fi
  dream_kill_child
  if [ "$DREAM_ACTIVE" -eq 1 ]; then dream_failure_finalize "$1" "opencode run interrupted (exit $1)"; fi
  dream_release_lock
  exit 1
}

# Did the sandbox leave the agent any working tool? Reads the run's own session
# database (session_message rows of type assistant; tool parts carry
# state.status and, when denied, state.error.type "permission.rejected").
# Sets DREAM_TOOLS_OK, DREAM_TOOLS_DENIED and DREAM_REPORT_STATE. Returns 0 when
# the run looks sane, 1 when the sandbox broke it, 2 when it cannot be inspected.
DREAM_TOOLS_OK=0
DREAM_TOOLS_DENIED=0
dream_sandbox_check() {   # dream_sandbox_check <db>
  local db="$1" out="" report=""
  DREAM_TOOLS_OK=0; DREAM_TOOLS_DENIED=0
  command -v sqlite3 >/dev/null 2>&1 || return 2
  [ -f "$db" ] || return 2
  out="$(sqlite3 -readonly -separator '|' "$db" "
    WITH t AS (
      SELECT m.seq AS seq, j.key AS k,
             json_extract(j.value, '\$.name') AS name,
             json_extract(j.value, '\$.state.status') AS status,
             json_extract(j.value, '\$.state.input.command') AS cmd,
             (coalesce(json_extract(j.value, '\$.state.error.type'), '') = 'permission.rejected'
              OR coalesce(json_extract(j.value, '\$.state.error.message'), '') LIKE 'Permission denied%') AS denied
      FROM session_message m, json_each(json_extract(m.data, '\$.content')) j
      WHERE m.type = 'assistant' AND json_extract(j.value, '\$.type') = 'tool')
    SELECT (SELECT count(*) FROM t WHERE status = 'completed'),
           (SELECT count(*) FROM t WHERE denied = 1),
           coalesce((SELECT status || ':' || denied FROM t
                     WHERE name = 'shell' AND cmd LIKE '%dream --report%'
                     ORDER BY seq, k LIMIT 1), '');
  " 2>/dev/null)" || return 2
  [ -n "$out" ] || return 2
  DREAM_TOOLS_OK="${out%%|*}"
  out="${out#*|}"
  DREAM_TOOLS_DENIED="${out%%|*}"
  report="${out#*|}"
  case "$DREAM_TOOLS_OK$DREAM_TOOLS_DENIED" in ''|*[!0-9]*) return 2 ;; esac
  [ "$DREAM_TOOLS_OK" -gt 0 ] || return 1
  case "$report" in *:1) return 1 ;; esac
  return 0
}

cmd_dream() {
  local usage="usage: memory dream [--report [--stale-days N]] [--workspace <ws>] [--model <provider/model>] [--if-changed] [--full] [--web] [--timeout <minutes>] [--print-config]"
  # AGENT_MEMORY_DREAM_MODEL sets the default model; --model overrides it.
  local report=0 stale_days="" workspace="" model="${AGENT_MEMORY_DREAM_MODEL:-}" print_config=0 model_flag=0 if_changed=0 full=0 web=0
  local timeout_min="${AGENT_MEMORY_DREAM_TIMEOUT:-120}" timeout_flag=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --report) report=1; shift ;;
      --print-config) print_config=1; shift ;;
      --if-changed) if_changed=1; shift ;;
      --full) full=1; shift ;;
      --web) web=1; shift ;;
      --timeout)
        [ $# -ge 2 ] || die "$usage"
        case "$2" in ''|*[!0-9]*) die "$usage" ;; esac
        timeout_min="$2"; timeout_flag=1; shift 2 ;;
      --stale-days)
        [ $# -ge 2 ] || die "$usage"
        case "$2" in ''|*[!0-9]*) die "$usage" ;; esac
        [ "$((10#$2))" -gt 0 ] || die "$usage"
        stale_days="$((10#$2))"; shift 2 ;;
      --workspace)
        [ $# -ge 2 ] || die "$usage"
        workspace="$2"; shift 2 ;;
      --model)
        if [ $# -lt 2 ] || [ -z "$2" ]; then die "$usage"; fi
        model="$2"; model_flag=1; shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  if [ "$report" -eq 1 ]; then
    { [ "$model_flag" -eq 0 ] && [ "$print_config" -eq 0 ] && [ "$if_changed" -eq 0 ] && [ "$full" -eq 0 ] \
      && [ "$web" -eq 0 ] && [ "$timeout_flag" -eq 0 ]; } || die "$usage"
  else
    [ -z "$stale_days" ] || die "$usage"
  fi
  [ -n "$stale_days" ] || stale_days=180
  case "$timeout_min" in ''|*[!0-9]*) die "invalid dream timeout '$timeout_min': use a whole number of minutes" ;; esac
  timeout_min="$((10#$timeout_min))"
  [ "$timeout_min" -gt 0 ] || die "$usage"

  [ -d "$MEMORY_HOME" ] || die "no store at $MEMORY_HOME (run 'memory init' first)"
  STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)"
  if [ -n "$workspace" ]; then
    require_slug "workspace name" "$workspace"
    [ -d "$STORE_HOME/$workspace" ] || die "no such workspace in the store: $workspace"
  fi

  if [ "$report" -eq 1 ]; then
    dream_report "$stale_days" "$workspace"
    return 0
  fi

  [ -d "$STORE_HOME/.git" ] || die "store at $STORE_HOME is not a git repository (run 'memory init' first)"
  if [ "$print_config" -eq 0 ]; then
    command -v opencode >/dev/null 2>&1 || die "opencode not found on PATH"
  fi

  local script assets config prompt nlchar=$'\n' bs=$'\\' quote='"' bad
  json_path_safe "${BASH_SOURCE[0]}" || die "cannot run dream: CLI path has unsafe JSON/policy metacharacters"
  script="$(canonical_path "${BASH_SOURCE[0]}")" || die "cannot resolve CLI path"
  assets="$(cd -P "$(dirname "$script")/.." && pwd -P)/dream"
  if [ ! -f "$assets/opencode.json" ] || [ ! -f "$assets/prompt.md" ]; then
    die "dream assets not found in $assets"
  fi
  for bad in "$MEMORY_HOME" "$STORE_HOME" "${HOME:-}" "$script"; do
    json_path_safe "$bad" || die "cannot run dream: path contains control characters or unsafe JSON/policy metacharacters (quote, backslash, newline, glob)"
    case "$bad" in
      *"$quote"*|*"$bs"*|*"$nlchar"*) die "cannot run dream: path contains a quote, backslash or newline: $bad" ;;
    esac
  done
  DREAM_WEB="$web"
  DREAM_PROJECT_DIRS="$(dream_project_dirs "$workspace")"
  config="$(<"$assets/opencode.json")"
  prompt="$(<"$assets/prompt.md")"
  config="$(dream_render "$config" "$STORE_HOME" "$script" "$HOME")"
  prompt="$(dream_render "$prompt" "$STORE_HOME" "$script" "$HOME")"
  [ -z "$workspace" ] || prompt="$prompt${nlchar}${nlchar}Workspace scope: $workspace"

  local last_ref="refs/memory-dream/last" last=""
  [ -z "$workspace" ] || last_ref="$last_ref-$workspace"
  last="$(git -C "$STORE_HOME" rev-parse -q --verify "$last_ref" 2>/dev/null || true)"
  [ "$full" -eq 1 ] || [ -z "$last" ] || prompt="$prompt${nlchar}${nlchar}$(dream_focus "$last" "$workspace")"

  if [ "$print_config" -eq 1 ]; then
    printf '%s\n---\n%s\n' "$config" "$prompt"
    return 0
  fi

  # The agent's read/edit rules match path strings, so a symlink inside the
  # store pointing elsewhere would be followed. Legitimate stores never hold
  # one (init/link-group only create links under .memory/ of a project).
  local store_links
  store_links="$(find "$STORE_HOME" -name .git -prune -o -type l -print 2>/dev/null | head -n 20 || true)"
  if [ -n "$store_links" ]; then
    die "cannot run dream: the store contains symlinks, which the agent's path rules would follow; remove them first:
$(printf '%s\n' "$store_links" | sed 's/^/  /')"
  fi

  # The lock comes first: the pre-run backup and the --if-changed check must not
  # race with a second dream or with plugin backups.
  dream_lock_acquire || die "another writer or memory dream is already running on this store (pid $(dream_lock_holder)); manual recovery: $(writer_lock_recovery_help)"
  local gitdir
  gitdir="$(store_gitdir)" || die "cannot locate the git directory of $STORE_HOME"

  # Commit pending changes first so the dream result is its own revertable commit.
  if [ -n "$(git -C "$STORE_HOME" status --porcelain --untracked-files=all)" ]; then
    cmd_backup >/dev/null
    echo "dream: committed pending store changes first"
  fi
  local pre="" rc=0 timed_out=0
  pre="$(git -C "$STORE_HOME" rev-parse -q --verify HEAD 2>/dev/null || true)"

  # --if-changed: skip when no fact changed since the last successful run
  # (a local ref, never pushed), so a nightly job costs nothing on quiet days.
  # Only fact files count: INDEX.md, .project-path and the like are ignored.
  if [ "$if_changed" -eq 1 ] && [ -n "$pre" ] && [ -n "$last" ] \
     && [ -z "$(git -C "$STORE_HOME" diff --name-only "$last" "$pre" -- ${workspace:+"$workspace/"} | grep -E '\.md$' | grep -v -E '(^|/)INDEX\.md$' || true)" ]; then
    dream_release_lock
    echo "dream: no fact changed since the last run — skipping"
    return 0
  fi

  # The run gets its own OpenCode database so the unattended session stays out
  # of the user's OpenCode session list. Inside .git it is never committed;
  # wiping it first keeps only the latest run's session and bounds its size.
  local db="$gitdir/memory-dream.db" flag="$gitdir/memory-dream.timeout" secs
  rm -f "$db" "$db-wal" "$db-shm" "$flag"
  secs="${AGENT_MEMORY_DREAM_TIMEOUT_SECS:-$((timeout_min * 60))}"

  # AGENT_MEMORY_HOME is pinned so the agent's `memory dream --report` sees
  # this store even when the caller passed a relative path. The project-config
  # switches keep a config or plugin written into the store from being loaded.
  dream_collect_levels ""
  DREAM_LEVELS_BEFORE="$(printf '%s\n' ${DREAM_RELS[@]+"${DREAM_RELS[@]}"})"
  DREAM_ACTIVE=1
  DREAM_WORKSPACE="$workspace"
  exec 3>&2
  DREAM_STDERR_SAVED=1
  set -m
  (
    cd "$STORE_HOME" || exit 1
    export AGENT_MEMORY_HOME="$STORE_HOME" OPENCODE_CONFIG_CONTENT="$config" OPENCODE_DB="$db" \
      OPENCODE_CONFIG_PROJECT_DISABLE=1 OPENCODE_DISABLE_PROJECT_CONFIG=1
    exec opencode run --standalone --agent memory-dream ${model:+--model "$model"} "$prompt"
  ) 3>&- &
  DREAM_CHILD_PID=$!
  DREAM_CHILD_GROUP="$DREAM_CHILD_PID"
  (
    sleep "$secs"
    : > "$flag"
    dream_kill_tree "$DREAM_CHILD_GROUP" TERM
    sleep "$DREAM_KILL_GRACE"
    dream_kill_tree "$DREAM_CHILD_GROUP" KILL
  ) >/dev/null 2>&1 3>&- &
  DREAM_WATCHDOG_PID=$!
  { wait "$DREAM_CHILD_PID" || rc=$?; } 2>/dev/null
  # If the timeout fired, await KILL escalation even if the parent already
  # exited on TERM. Its descendants can still hold files or keep writing.
  if [ -e "$flag" ]; then
    timed_out=1
    { wait "$DREAM_WATCHDOG_PID" || true; } 2>/dev/null
    DREAM_WATCHDOG_PID=""
    rm -f "$flag"
  else
    dream_stop_watchdog
    # Also terminate tools left by a normally exiting parent.
    dream_kill_tree "$DREAM_CHILD_GROUP" TERM
    if kill -0 -- "-$DREAM_CHILD_GROUP" 2>/dev/null; then
      sleep "$DREAM_KILL_GRACE"
      dream_kill_tree "$DREAM_CHILD_GROUP" KILL
    fi
  fi
  DREAM_CHILD_PID=""
  DREAM_CHILD_GROUP=""
  set +m

  if [ "$rc" -ne 0 ] || [ "$timed_out" -eq 1 ]; then
    [ "$rc" -ne 0 ] || rc=1
    local why="opencode run failed (exit $rc)"
    [ "$timed_out" -eq 0 ] || why="opencode run timed out after $timeout_min minute(s) (exit $rc)"
    dream_failure_finalize "$rc" "$why"
    dream_release_lock
    return 1
  fi

  # The matcher cannot stop new project/group directories, nested files or
  # hidden files; the run is then a failed review, not a success.
  if [ -n "$(dream_unexpected_paths)" ]; then
    dream_failure_finalize 1 "the agent wrote outside the allowed fact paths; run not counted"
    dream_release_lock
    return 1
  fi

  # A sandbox that denies every tool makes opencode exit 0 after doing nothing;
  # that must not count as a quiet night (and so must not advance the marker).
  local sandbox_status=0
  dream_sandbox_check "$db" || sandbox_status=$?
  case "$sandbox_status" in
    1)
      dream_failure_finalize 1 "sandbox denied the agent's tools; run not counted ($DREAM_TOOLS_OK tool call(s) succeeded, $DREAM_TOOLS_DENIED denied)"
      dream_release_lock
      return 1 ;;
    2) echo "memory: dream: cannot inspect the session database (sqlite3 or db missing); sandbox not verified" >&2 ;;
  esac

  index_rebuild_levels "$workspace"
  cmd_backup >/dev/null
  local final_sha
  if store_git rev-parse -q --verify HEAD >/dev/null 2>&1; then
    final_sha="$(store_git rev-parse --verify HEAD)"
  elif [ -n "$(store_git status --porcelain --untracked-files=all)" ]; then
    die "cannot resolve final dream commit"
  else
    final_sha="" # genuinely empty store; no commit/ref to record
  fi
  if [ -n "$final_sha" ]; then store_git update-ref "$last_ref" "$final_sha"; fi
  DREAM_ACTIVE=0
  dream_release_lock

  local base="$pre"
  [ -n "$base" ] || base="$(git -C "$STORE_HOME" hash-object -t tree /dev/null)"
  if git -C "$STORE_HOME" rev-parse -q --verify HEAD >/dev/null 2>&1 \
     && [ -n "$(git -C "$STORE_HOME" diff --stat "$base" HEAD)" ]; then
    local since="the start"
    [ -z "$pre" ] || since="$(git -C "$STORE_HOME" rev-parse --short "$pre")"
    echo "dream: changes since $since:"
    git -C "$STORE_HOME" diff --stat "$base" HEAD
  else
    echo "dream: no changes"
  fi
  [ "$DREAM_TOOLS_DENIED" -eq 0 ] || echo "dream: $DREAM_TOOLS_DENIED tool call(s) were denied by the sandbox ($DREAM_TOOLS_OK succeeded)"
  echo "dream: session transcript in $db (latest run only)"
}

# Number of fact files in a level directory (INDEX.md excluded).
count_facts() {
  local n=0 f
  for f in "$1"/*.md; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = "INDEX.md" ] && continue
    n=$((n + 1))
  done
  echo "$n"
}

cmd_status() {
  [ $# -eq 0 ] || die "usage: memory status"
  [ -d .memory ] || die "no .memory/ here (run 'memory init <workspace>' first)"
  [ -d "$MEMORY_HOME" ] || die "store missing: $MEMORY_HOME (set AGENT_MEMORY_HOME or restore it)"
  STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)"
  local ws_dir ws proj g name target top linked=" " other="" uncommitted last
  ws_dir="$(safe_link_target .memory/workspace)" || die "unsafe or broken symlink: .memory/workspace (run 'memory doctor')"
  [ -d "$ws_dir" ] || die "unsafe or broken symlink: .memory/workspace (run 'memory doctor')"
  proj="$(safe_link_target .memory/project)" || die "unsafe or broken symlink: .memory/project (run 'memory doctor')"
  [ -d "$proj" ] || die "unsafe or broken symlink: .memory/project (run 'memory doctor')"
  ws="$(dirname "$ws_dir")"
  echo "store:      $STORE_HOME"
  echo "workspace:  $(basename "$ws")  ($(count_facts "$ws_dir") facts)"
  echo "project:    $(basename "$proj")  ($(count_facts "$proj") facts)  -> $proj"
  for g in .memory/groups/*; do
    [ -L "$g" ] || continue
    name="$(basename "$g")"
    target="$(safe_link_target "$g" 2>/dev/null || true)"
    if [ -n "$target" ] && [ -d "$target" ]; then
      echo "group:      $name  ($(count_facts "$target") facts)"
      linked="$linked$name "
    else
      echo "group:      $name  (UNSAFE OR BROKEN LINK — run 'memory doctor')"
    fi
  done
  # Groups that exist in this workspace but are not linked here: the nudge to
  # put shared facts where siblings can see them.
  for g in "$ws"/groups/*/; do
    [ -d "$g" ] || continue
    name="$(basename "$g")"
    case "$linked" in *" $name "*) ;; *) other="$other $name" ;; esac
  done
  [ -z "$other" ] || echo "not linked: ${other# }  (memory link-group <group>)"
  top="$(git -C "$STORE_HOME" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && top="$(cd -P "$top" && pwd -P)" && [ "$top" = "$STORE_HOME" ]; then
    uncommitted="$(git -C "$STORE_HOME" status --porcelain --untracked-files=all | wc -l | tr -d ' ')"
    last="$(git -C "$STORE_HOME" log -1 --format=%cd --date=short 2>/dev/null || echo never)"
    if [ "$uncommitted" -eq 0 ]; then
      echo "backup:     last $last, store clean"
    else
      echo "backup:     last $last, $uncommitted uncommitted path(s) — run 'memory backup'"
    fi
  else
    echo "backup:     unavailable (store is not a git repository)"
  fi
}

# Full-text search over every linked level. Plain `rg`/`grep -r` never see
# .memory/ (gitignored symlinks); validated root paths let `grep -r` search
# them without following nested symlinks.
cmd_grep() {
  [ $# -ge 1 ] || die "usage: memory grep <pattern> [extra grep options]"
  [ -d .memory ] || die "no .memory/ here (run 'memory init <workspace>' first)"
  [ -d "$MEMORY_HOME" ] || die "store missing: $MEMORY_HOME (set AGENT_MEMORY_HOME or restore it)"
  STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)"
  local pattern="$1" d target rc=0
  shift
  local -a dirs=()
  for d in .memory/project .memory/workspace; do
    target="$(safe_link_target "$d")" || die "unsafe or broken symlink: $d (run 'memory doctor')"
    [ -d "$target" ] || die "unsafe or broken symlink: $d (run 'memory doctor')"
    dirs+=("$d/")
  done
  for d in .memory/groups/*; do
    [ -L "$d" ] || continue
    target="$(safe_link_target "$d")" || die "unsafe or broken symlink: $d (run 'memory doctor')"
    [ -d "$target" ] || die "unsafe or broken symlink: $d (run 'memory doctor')"
    dirs+=("$d/")
  done
  grep -r -n -i --exclude='.project-path' "$@" -- "$pattern" "${dirs[@]}" || rc=$?
  case "$rc" in
    0) ;;
    1) echo "no matches for '$pattern'" ;;
    *) die "grep failed (exit $rc)" ;;
  esac
}

# Builds the structured commit message for `memory backup` from the staged
# diff. Classifies each changed store path against the store layout
# `<ws>/projects/<name>/<slug>.md`, `<ws>/groups/<name>/<slug>.md`,
# `<ws>/workspace/<slug>.md`; anything else becomes scope "other" with the
# raw path as its "slug". A level's `INDEX.md` is never listed as a fact.
# `git diff --cached --name-status` diffs against the empty tree when there
# is no HEAD yet, so this also covers the very first commit into the store.
backup_commit_message() {
  git -C "$MEMORY_HOME" diff --cached --name-status -M \
    | awk -v ts="$(date +%Y-%m-%dT%H:%M:%S)" '
    BEGIN { FS = "\t" }

    # Classifies one store-relative path. Sets CL_SCOPE / CL_SLUG / CL_ISINDEX.
    function classify(path,   n, arr) {
      n = split(path, arr, "/")
      CL_ISINDEX = 0
      if (n == 4 && arr[2] == "projects" && arr[4] ~ /\.md$/) {
        CL_SCOPE = arr[3]; CL_FILE = arr[4]
      } else if (n == 4 && arr[2] == "groups" && arr[4] ~ /\.md$/) {
        CL_SCOPE = "group:" arr[3]; CL_FILE = arr[4]
      } else if (n == 3 && arr[2] == "workspace" && arr[3] ~ /\.md$/) {
        CL_SCOPE = "workspace:" arr[1]; CL_FILE = arr[3]
      } else {
        CL_SCOPE = "other"; CL_FILE = ""; CL_SLUG = path
        return
      }
      if (CL_FILE == "INDEX.md") CL_ISINDEX = 1
      CL_SLUG = CL_FILE
      sub(/\.md$/, "", CL_SLUG)
    }

    function addTo(op, scope, item,   c) {
      seenScope[scope] = 1
      c = ++opCount[op, scope]
      opItem[op, scope, c] = item
    }

    {
      code = substr($1, 1, 1)
      if (code == "R") {
        classify($3); nscope = CL_SCOPE; nslug = CL_SLUG; nidx = CL_ISINDEX
        classify($2); oslug = CL_SLUG
        if (nidx) { indexScope[nscope] = 1; next }
        addTo("rename", nscope, oslug "->" nslug)
        totalRename++
        next
      }
      if (code != "A" && code != "M" && code != "D") code = "M"   # defensive fallback
      classify($2)
      if (CL_ISINDEX) { indexScope[CL_SCOPE] = 1; next }
      if (code == "A") { addTo("add", CL_SCOPE, CL_SLUG); totalAdd++ }
      else if (code == "D") { addTo("remove", CL_SCOPE, CL_SLUG); totalRemove++ }
      else { addTo("update", CL_SCOPE, CL_SLUG); totalUpdate++ }
    }

    function joinFirst(op, scope, k,   s, i) {
      s = ""
      for (i = 1; i <= k; i++) s = (i == 1) ? opItem[op, scope, i] : s ", " opItem[op, scope, i]
      return s
    }

    # Full clause text for one scope: "add a, b; update c; rename x->y; remove d"
    function fullClause(scope,   parts, np, s, i) {
      np = 0
      if (opCount["add", scope] > 0) parts[++np] = "add " joinFirst("add", scope, opCount["add", scope])
      if (opCount["update", scope] > 0) parts[++np] = "update " joinFirst("update", scope, opCount["update", scope])
      if (opCount["rename", scope] > 0) parts[++np] = "rename " joinFirst("rename", scope, opCount["rename", scope])
      if (opCount["remove", scope] > 0) parts[++np] = "remove " joinFirst("remove", scope, opCount["remove", scope])
      s = (np > 0) ? parts[1] : ""
      for (i = 2; i <= np; i++) s = s "; " parts[i]
      return s
    }

    function countsClause(scope,   parts, np, s, i, c) {
      np = 0
      c = opCount["add", scope]; if (c > 0) parts[++np] = "add " c
      c = opCount["update", scope]; if (c > 0) parts[++np] = "update " c
      c = opCount["rename", scope]; if (c > 0) parts[++np] = "rename " c
      c = opCount["remove", scope]; if (c > 0) parts[++np] = "remove " c
      s = (np > 0) ? parts[1] : ""
      for (i = 2; i <= np; i++) s = s ", " parts[i]
      return s
    }

    function totalItems(scope) {
      return opCount["add", scope] + opCount["update", scope] + opCount["rename", scope] + opCount["remove", scope]
    }

    # Subject clause for one scope, showing at most k items in total (in
    # add/update/rename/remove priority order) with "+N more" for the rest.
    function truncatedClause(scope, k,   remaining, shown_a, shown_u, shown_r, shown_rm, total, omitted, parts, np, s, i) {
      remaining = k
      shown_a = (opCount["add", scope] < remaining) ? opCount["add", scope] : remaining; remaining -= shown_a
      shown_u = (opCount["update", scope] < remaining) ? opCount["update", scope] : remaining; remaining -= shown_u
      shown_r = (opCount["rename", scope] < remaining) ? opCount["rename", scope] : remaining; remaining -= shown_r
      shown_rm = (opCount["remove", scope] < remaining) ? opCount["remove", scope] : remaining; remaining -= shown_rm
      total = totalItems(scope)
      omitted = total - k
      np = 0
      if (shown_a > 0) parts[++np] = "add " joinFirst("add", scope, shown_a)
      if (shown_u > 0) parts[++np] = "update " joinFirst("update", scope, shown_u)
      if (shown_r > 0) parts[++np] = "rename " joinFirst("rename", scope, shown_r)
      if (shown_rm > 0) parts[++np] = "remove " joinFirst("remove", scope, shown_rm)
      s = (np > 0) ? parts[1] : ""
      for (i = 2; i <= np; i++) s = s "; " parts[i]
      if (omitted > 0) s = (s == "") ? ("+" omitted " more") : (s " +" omitted " more")
      return s
    }

    # Best-fitting <= 72-char subject for a single scope: full list, then
    # progressively fewer items with "+N more" (always naming at least one
    # fact), then bare counts such as "add 1".
    function singleScopeSubject(scope,   full, prefix, k, cand, total) {
      prefix = "memory(" scope "): "
      full = prefix fullClause(scope)
      if (length(full) <= 72) return full
      total = totalItems(scope)
      for (k = total - 1; k >= 1; k--) {
        cand = prefix truncatedClause(scope, k)
        if (length(cand) <= 72) return cand
      }
      return prefix countsClause(scope)
    }

    function ssort(arr, n,    i, j, tmp) {
      for (i = 2; i <= n; i++) {
        tmp = arr[i]; j = i - 1
        while (j >= 1 && arr[j] > tmp) { arr[j + 1] = arr[j]; j-- }
        arr[j + 1] = tmp
      }
    }

    END {
      ns = 0
      for (k in seenScope) scopes[++ns] = k
      ssort(scopes, ns)

      if (ns == 0) {
        nis = 0
        for (k in indexScope) idxScopes[++nis] = k
        ssort(idxScopes, nis)
        if (nis == 1) subject = "memory(" idxScopes[1] "): reindex"
        else subject = "memory: reindex " nis " scopes"
        print subject
        print ""
        print "backup " ts
        exit
      }

      if (ns == 1) {
        subject = singleScopeSubject(scopes[1])
      } else {
        pn = 0
        if (totalAdd > 0) mparts[++pn] = "add " totalAdd
        if (totalUpdate > 0) mparts[++pn] = "update " totalUpdate
        if (totalRename > 0) mparts[++pn] = "rename " totalRename
        if (totalRemove > 0) mparts[++pn] = "remove " totalRemove
        s = mparts[1]
        for (i = 2; i <= pn; i++) s = s ", " mparts[i]
        subject = "memory: " s " in " ns " scopes"
      }

      print subject
      print ""
      for (i = 1; i <= ns; i++) print scopes[i] ": " fullClause(scopes[i])
      print "backup " ts
    }
  '
}

# Diagnostic only; acquisition never depends on a check-then-act pid test.
dream_lock_holder() {
  local lock pid="" start="" current
  lock="$(store_gitdir)/memory-dream.lock"
  if [ -d "$lock" ]; then
    if [ ! -f "$lock/owner" ]; then echo "unpublished (do not remove)"; return; fi
    { IFS= read -r pid; IFS= read -r start; } < "$lock/owner" || true
  elif [ -f "$lock" ]; then
    IFS= read -r pid < "$lock" || true
  else
    return 0
  fi
  current="$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//; s/ *$//' || true)"
  if [ -n "$start" ] && [ "$current" = "$start" ]; then echo "$pid"; else echo "$pid; stale or uncertain, manual recovery required"; fi
}

cmd_backup() {
  local push=0 own_lock=0 marker failed_rc failed_detail failure_status=0
  case "$#" in 0) ;; 1) [ "$1" = "--push" ] || die "usage: memory backup [--push]"; push=1 ;; *) die "usage: memory backup [--push]" ;; esac
  [ -d "$MEMORY_HOME/.git" ] || die "no store at $MEMORY_HOME (run 'memory init' first)"
  STORE_HOME="$(cd -P "$MEMORY_HOME" && pwd -P)"
  # While `memory dream` runs, other backups (the OpenCode plugin commits after
  # every agent step, in any session) would split its result into many commits.
  # Dream commits everything itself when it finishes (and is not "another"
  # process: DREAM_LOCK_OWNER is its own pid).
  if [ -z "$DREAM_LOCK_FILE" ]; then
    local attempts=0 wait_seconds="${AGENT_MEMORY_BACKUP_LOCK_WAIT:-10}"
    case "$wait_seconds" in ''|*[!0-9]*) die "invalid AGENT_MEMORY_BACKUP_LOCK_WAIT" ;; esac
    until dream_lock_acquire; do
      if [ "$attempts" -ge "$wait_seconds" ]; then
        echo "memory: backup busy; request NOT saved, retry backup (exit 75). $(writer_lock_recovery_help)" >&2
        return 75
      fi
      attempts=$((attempts + 1))
      sleep 1
    done
    own_lock=1
  fi
  marker="$(store_gitdir)/memory-dream.failed"
  if [ -f "$marker" ]; then
    failed_rc="$(head -n 1 "$marker")"
    failed_detail="$(tail -n +2 "$marker")"
    dream_commit_failed "$failed_rc" "$failed_detail" || failure_status=$?
    [ "$failure_status" -ne 3 ] || die "FAILED review commit could not be created; failure marker retained"
    if [ "$failure_status" -eq 0 ]; then echo "backed up FAILED review; undo with: git -C '$STORE_HOME' revert HEAD"; fi
  fi
  store_retry store_git add -A || die "git add failed in $STORE_HOME"
  if store_git diff --cached --quiet 2>/dev/null; then
    echo "nothing to back up"
  else
    local msg
    msg="$(backup_commit_message)" || die "failed to build commit message"
    store_retry store_git commit -q -m "$msg" \
      || die "commit failed in $STORE_HOME — is git user.name / user.email configured?"
    echo "backed up"
  fi
  if [ "$push" -eq 1 ]; then
    store_git remote get-url origin >/dev/null 2>&1 || die "no remote configured (git -C $STORE_HOME remote add origin <url>)"
    store_git symbolic-ref -q HEAD >/dev/null 2>&1 \
      || die "store is on a detached HEAD; check out a branch (git -C $STORE_HOME switch <branch>) before 'backup --push'"
    GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}" store_git push -q origin HEAD
  fi
  [ "$own_lock" -eq 0 ] || dream_release_lock
}

cmd_install_opencode() {
  [ $# -eq 0 ] || die "usage: memory install-opencode"
  local source script config_dir destination current
  script="$(canonical_path "${BASH_SOURCE[0]}")" || die "cannot resolve CLI path"
  source="$(cd -P "$(dirname "$script")/.." && pwd -P)/opencode/agent-memory.js"
  [ -f "$source" ] || die "OpenCode plugin not found at $source"
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins"
  destination="$config_dir/agent-memory.js"
  mkdir -p "$config_dir"
  if [ -L "$destination" ]; then
    current="$(canonical_path "$destination" 2>/dev/null)" || current=""   # dangling link: replace it
    [ "$current" = "$source" ] && { echo "OpenCode plugin already installed: $destination"; return 0; }
    rm "$destination"
  elif [ -e "$destination" ]; then
    die "refusing to overwrite non-symlink: $destination"
  fi
  ln -s "$source" "$destination"
  echo "installed OpenCode plugin: $destination (restart OpenCode to load it)"
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    init) cmd_init "$@" ;; link-group) cmd_link_group "$@" ;; unlink-group) cmd_unlink_group "$@" ;;
    index) cmd_index "$@" ;; status) cmd_status "$@" ;; grep) cmd_grep "$@" ;; doctor) cmd_doctor "$@" ;; dream) cmd_dream "$@" ;; backup) cmd_backup "$@" ;; install-opencode) cmd_install_opencode "$@" ;;
    -v|--version) [ $# -eq 0 ] || die "usage: memory --version"; echo "memory $VERSION" ;;
    -h|--help) [ $# -eq 0 ] || die "usage: memory --help"; usage ;;
    "") usage >&2; exit 1 ;;
    *) die "unknown command: $cmd (see 'memory --help')" ;;
  esac
}

# `exit` on the same line: bash reads a script as it runs, so without it an
# edit or `git pull` of this file during a long `memory dream` would make bash
# execute whatever bytes now follow this line.
main "$@"; exit $?
