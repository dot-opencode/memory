#!/bin/sh
# memory launcher: fetches the prebuilt `memory` binary pinned in release.txt
# from GitHub Releases (dot-opencode/memory), verifies its sha256, caches it
# and execs it.
#
# Environment:
#   AGENT_MEMORY_BIN                   exec this binary instead (skips download)
#   AGENT_MEMORY_RELEASE_BASE_URL      test-only: replaces
#                                      https://github.com/dot-opencode/memory/releases/download
#   XDG_CACHE_HOME                     cache root (default: $HOME/.cache)

set -eu

die() {
  printf 'memory: %s\n' "$*" >&2
  exit 1
}

# --- resolve this script's absolute path, following symlinks ---------------
resolve_self() {
  p=$1
  while [ -h "$p" ]; do
    dir=$(cd -P "$(dirname "$p")" && pwd)
    link=$(readlink "$p")
    case $link in
      /*) p=$link ;;
      *) p=$dir/$link ;;
    esac
  done
  dir=$(cd -P "$(dirname "$p")" && pwd)
  printf '%s/%s\n' "$dir" "$(basename "$p")"
}

SELF=$(resolve_self "$0")
SELF_DIR=$(dirname "$SELF")

if [ -n "${AGENT_MEMORY_BIN:-}" ]; then
  AGENT_MEMORY_SELF=$SELF
  export AGENT_MEMORY_SELF
  exec "$AGENT_MEMORY_BIN" "$@"
fi

RELEASE_FILE=$SELF_DIR/release.txt
[ -r "$RELEASE_FILE" ] || die "missing $RELEASE_FILE"

VERSION=$(awk '$1 == "version" { print $2; exit }' "$RELEASE_FILE")
[ -n "$VERSION" ] || die "no 'version' line in $RELEASE_FILE"

# --- target detection --------------------------------------------------------
OS=$(uname -s)
ARCH=$(uname -m)
TARGET=
case "$OS/$ARCH" in
  Darwin/arm64 | Darwin/aarch64) TARGET=aarch64-apple-darwin ;;
  Darwin/x86_64) TARGET=x86_64-apple-darwin ;;
  Linux/x86_64 | Linux/amd64) TARGET=x86_64-unknown-linux-musl ;;
  Linux/aarch64 | Linux/arm64) TARGET=aarch64-unknown-linux-musl ;;
esac
[ -n "$TARGET" ] || die "unsupported platform $OS/$ARCH; set AGENT_MEMORY_BIN to a memory binary or build one with: cargo install --git https://github.com/dot-opencode/memory"

CACHE_ROOT=${XDG_CACHE_HOME:-${HOME:-}/.cache}
if [ -z "$CACHE_ROOT" ] || [ "$CACHE_ROOT" = "/.cache" ]; then
  die "cannot determine cache directory (set HOME or XDG_CACHE_HOME)"
fi
CACHE_DIR=$CACHE_ROOT/agent-memory/$VERSION/$TARGET
BIN=$CACHE_DIR/memory

run() {
  AGENT_MEMORY_SELF=$SELF
  export AGENT_MEMORY_SELF
  exec "$BIN" "$@"
}

if [ -x "$BIN" ]; then
  run "$@"
fi

# --- download + verify -------------------------------------------------------
EXPECTED=$(awk -v t="$TARGET" '$1 == "sha256" && $2 == t { print $3; exit }' "$RELEASE_FILE")
[ -n "$EXPECTED" ] || die "no sha256 for $TARGET in $RELEASE_FILE"

BASE_URL=${AGENT_MEMORY_RELEASE_BASE_URL:-https://github.com/dot-opencode/memory/releases/download}
URL=$BASE_URL/v$VERSION/memory-$TARGET.tar.gz

mkdir -p "$CACHE_DIR" || die "cannot create $CACHE_DIR"
WORK=$(mktemp -d "$CACHE_DIR/.tmp.XXXXXX") || die "cannot create temp dir in $CACHE_DIR"
trap 'rm -rf "$WORK"' EXIT HUP INT TERM

ARCHIVE=$WORK/memory.tar.gz
printf 'memory: downloading %s\n' "$URL" >&2
if command -v curl >/dev/null 2>&1; then
  curl -fsSL --retry 2 -o "$ARCHIVE" "$URL" || die "download failed: $URL"
elif command -v wget >/dev/null 2>&1; then
  wget -q -O "$ARCHIVE" "$URL" || die "download failed: $URL"
else
  die "need curl or wget to download $URL"
fi

if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL=$(sha256sum "$ARCHIVE" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  ACTUAL=$(shasum -a 256 "$ARCHIVE" | awk '{ print $1 }')
else
  die "need sha256sum or shasum to verify the download"
fi
[ "$ACTUAL" = "$EXPECTED" ] || die "checksum mismatch for $URL (expected $EXPECTED, got $ACTUAL); refusing to run"

mkdir "$WORK/x"
tar -xzf "$ARCHIVE" -C "$WORK/x" memory || die "cannot extract memory from archive"
[ -f "$WORK/x/memory" ] || die "archive does not contain memory"
chmod +x "$WORK/x/memory"
# Atomic publish; concurrent runs each verified the same bytes, last rename wins.
mv -f "$WORK/x/memory" "$BIN" || die "cannot install $BIN"
# exec skips the EXIT trap, so clean up explicitly.
rm -rf "$WORK"
trap - EXIT HUP INT TERM

run "$@"
